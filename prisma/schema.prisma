generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["interactiveTransactions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChatRoom {
  id        BigInt     @id(map: "pk_chat_rooms")
  messages  Message[]
  chatUsers ChatUser[]
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @db.Timestamptz(6)

  @@map("chat_rooms")
}

model Comment {
  id        BigInt    @id(map: "pk_comments")
  comment   String    @db.VarChar(255)
  likeCount Int       @default(0) @map("like_count")
  userId    BigInt    @map("user_id")
  postId    BigInt    @map("post_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_comments_users")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_comments_posts")

  @@map("comments")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Image {
  id        BigInt    @id(map: "pk_images")
  order     Int       @default(0)
  type      ImageType
  path      String    @db.VarChar(255)
  postId    BigInt?   @map("post_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade, map: "fk_images_posts")

  @@map("images")
}

model Message {
  id         BigInt    @id(map: "pk_messages")
  message    String    @db.VarChar(255)
  chatRoomId BigInt    @map("chat_room_id")
  userId     BigInt    @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_messages_users")
  chatRoom   ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_messages_chat_rooms")

  @@map("messages")
}

model Post {
  id           BigInt    @id(map: "pk_posts")
  title        String    @db.VarChar(255)
  content      String
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  userId       BigInt
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  comments     Comment[]
  images       Image[]
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_posts_users")

  @@map("posts")
}

model Follow {
  id          BigInt    @id(map: "pk_follows")
  isConfirmed Boolean   @default(false)
  followerId  BigInt    @map("follower_id")
  followeeId  BigInt    @map("followee_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  followee    User      @relation("followee_id", fields: [followeeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_follows_users_followee")
  follower    User      @relation("follower_id", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_follows_users_follower")

  @@map("follows")
}

model User {
  id            BigInt       @id(map: "pk_users")
  nickname      String       @unique(map: "uq_users_nickname") @db.VarChar(20)
  email         String       @unique(map: "uq_users_email") @db.VarChar(255)
  password      String       @db.VarChar(255)
  role          UserRoleEnum @default(USER)
  followerCount Int          @default(0) @map("follower_count")
  followeeCount Int          @default(0) @map("followee_count")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @db.Timestamptz(6)
  comments      Comment[]
  messages      Message[]
  posts         Post[]
  followees     Follow[]     @relation("followee_id")
  followers     Follow[]     @relation("follower_id")
  chatUsers     ChatUser[]

  @@map("users_model")
}

model ChatUser {
  id         BigInt    @id(map: "pk_chat_users")
  userId     BigInt    @map("users_id")
  chatRoomId BigInt    @map("chats_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_chat_users_users")
  chatRoom   ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_chat_users_chat_rooms")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @db.Timestamptz(6)

  @@map("chat_users")
}

enum UserRoleEnum {
  ADMIN
  USER
}

enum ImageType {
  POST
}
